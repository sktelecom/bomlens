{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "dependencyDashboard": true,
  "labels": ["dependencies", "tool-upgrade", "run-heavy-e2e"],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 5,
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "Surface tool major bumps (e.g. cdxgen v12 -> v13) as their own PR for a deliberate, snapshot-reviewed upgrade.",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-upgrade"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tools pinned as ARG in the scanner Dockerfile (curl/pip installed; invisible to Dependabot).",
      "fileMatch": ["(^|/)docker/Dockerfile$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\nARG \\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Tools pinned as a workflow env value and downloaded at run time (invisible to Dependabot).",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.yml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s+[\\w-]+: (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "cdxgen language-image tag and all-in-one image pinned as shell vars in source-detect.sh.",
      "fileMatch": ["(^|/)docker/lib/source-detect\\.sh$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nCDXGEN_\\w+=\"\\$\\{CDXGEN_\\w+:-(?:ghcr\\.io/cyclonedx/cdxgen:)?(?<currentValue>[^}\"]+)\\}\""
      ]
    },
    {
      "customType": "regex",
      "description": "Docker image reference's syft row (check-doc-image-version-coverage.sh fails CI if this drifts from the Dockerfile ARG).",
      "fileMatch": ["(^|/)docs/reference/docker-image\\.md$", "(^|/)docs/reference/docker-image\\.ko\\.md$"],
      "matchStrings": ["\\| syft \\| (?<currentValue>v?[\\d.]+) \\|"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "anchore/syft"
    },
    {
      "customType": "regex",
      "description": "Docker image reference's Trivy row (check-doc-image-version-coverage.sh fails CI if this drifts from the Dockerfile ARG).",
      "fileMatch": ["(^|/)docs/reference/docker-image\\.md$", "(^|/)docs/reference/docker-image\\.ko\\.md$"],
      "matchStrings": ["\\| Trivy \\| (?<currentValue>v?[\\d.]+) \\|"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "aquasecurity/trivy"
    },
    {
      "customType": "regex",
      "description": "Docker image reference's cosign row (check-doc-image-version-coverage.sh fails CI if this drifts from the Dockerfile ARG).",
      "fileMatch": ["(^|/)docs/reference/docker-image\\.md$", "(^|/)docs/reference/docker-image\\.ko\\.md$"],
      "matchStrings": ["\\| cosign \\| (?<currentValue>v?[\\d.]+) \\|"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sigstore/cosign"
    },
    {
      "customType": "regex",
      "description": "Docker image reference's ScanCode Toolkit row (check-doc-image-version-coverage.sh fails CI if this drifts from the Dockerfile ARG).",
      "fileMatch": ["(^|/)docs/reference/docker-image\\.md$", "(^|/)docs/reference/docker-image\\.ko\\.md$"],
      "matchStrings": ["\\| ScanCode Toolkit \\| (?<currentValue>v?[\\d.]+) \\|"],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "scancode-toolkit"
    },
    {
      "customType": "regex",
      "description": "Docker image reference's docker CLI row (check-doc-image-version-coverage.sh fails CI if this drifts from the Dockerfile ARG).",
      "fileMatch": ["(^|/)docs/reference/docker-image\\.md$", "(^|/)docs/reference/docker-image\\.ko\\.md$"],
      "matchStrings": ["\\| docker CLI \\| (?<currentValue>v?[\\d.]+) \\|"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "docker/cli",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Docker image reference's cdxgen row (check-doc-image-version-coverage.sh fails CI if this drifts from the Dockerfile ARG).",
      "fileMatch": ["(^|/)docs/reference/docker-image\\.md$", "(^|/)docs/reference/docker-image\\.ko\\.md$"],
      "matchStrings": ["\\| cdxgen \\| (?<currentValue>v?[\\d.]+) \\|"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@cyclonedx/cdxgen"
    }
  ]
}
