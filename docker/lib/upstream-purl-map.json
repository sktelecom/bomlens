      "normalize": ["release"], "verified": ["1.0.2h", "1.1.1w"] },

    { "id": "openssl-3", "names": ["openssl", "libopenssl", "openssl-util", "openssl-bin", "libssl3", "libcrypto3"], "cpe": ["openssl:openssl"],
