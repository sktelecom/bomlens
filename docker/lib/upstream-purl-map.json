      "normalize": ["release"], "verified": ["1.00", "1.18.3", "1.22.1", "1.36.1"] },

    { "id": "curl", "names": ["curl", "libcurl"], "cpe": ["haxx:curl", "haxx:libcurl"],
      "purl": "pkg:github/curl/curl", "version": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "tag": "curl-{v_}",
      "normalize": ["release"], "verified": ["8.3.0"] },

    { "id": "openssl-1", "names": ["openssl", "libopenssl", "openssl-util"], "cpe": ["openssl:openssl"],
