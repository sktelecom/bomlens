{
  "spec": "2026 Minimum Elements for a Software Bill of Materials (CISA/NSA/FBI with 15 international partners, v2.1, 2026-07-29), which replaces the NTIA minimum elements of 2021",
  "subject": "[.components[]?]",
  "subjectLabel": "component",
  "emptySubjectDetail": "no components",
  "note": "Declarative map of the 2026 SBOM minimum elements — 17 data fields and 6 practices — to CycloneDX checks, read by validate-sbom.sh's registry evaluator. Read docker/lib/g7-registry.json's note for the element shapes; this registry uses the same ones, with all components as its subject rather than model components. Every element is advisory (required is absent, so false): the baseline itself draws no such line, but promoting a field to mandatory here fails an SBOM for a value it may legitimately not have, and the guidance gives the way out — state that the information is unknown. Nothing writes that statement yet, so the promotion waits for the notation that makes it expressible. The six practices are about how an organisation operates rather than about the document, so they carry no automated source and surface as human review; the exception is machine-processable data, which the format detection has already established by the time this runs.",
  "clusters": [
    {
      "id": "cisa-metadata",
      "name": "SBOM metadata",
      "name_ko": "SBOM 메타데이터",
      "elements": [
        {
          "id": "cisa-sbom-author",
          "label": "SBOM author",
          "label_ko": "SBOM 작성자",
          "source": "declared",
          "cdxPath": "((.metadata.authors // []) | length > 0) or ((.metadata.supplier // null) != null) or ((.metadata.manufacturer // null) != null)"
        },
        {
          "id": "cisa-sbom-author-signature",
          "label": "SBOM author signature",
          "label_ko": "SBOM 작성자 서명",
          "source": "declared",
          "cdxPath": "(.signature // null) != null"
        },
        {
          "id": "cisa-sbom-format-name",
          "label": "SBOM data format name",
          "label_ko": "SBOM 데이터 형식 이름",
          "source": "auto",
          "cdxPath": "(.bomFormat // \"\") != \"\""
        },
        {
          "id": "cisa-sbom-format-version",
          "label": "SBOM data format version",
          "label_ko": "SBOM 데이터 형식 버전",
          "source": "auto",
          "cdxPath": "(.specVersion // \"\") != \"\""
        },
        {
          "id": "cisa-sbom-generation-context",
          "label": "SBOM generation context",
          "label_ko": "SBOM 생성 시점",
          "source": "auto",
          "cdxPath": "[ (.metadata.lifecycles // [])[] | select(((.phase // \"\") != \"\") or ((.name // \"\") != \"\")) ] | length > 0"
        },
        {
          "id": "cisa-sbom-timestamp",
          "label": "SBOM timestamp",
          "label_ko": "SBOM 생성 시각",
          "source": "auto",
          "cdxPath": "(.metadata.timestamp // \"\") != \"\""
        },
        {
          "id": "cisa-sbom-tool-name",
          "label": "SBOM tool name",
          "label_ko": "SBOM 생성 도구 이름",
          "source": "auto",
          "cdxPath": "[ (if ((.metadata.tools // null) | type) == \"array\" then (.metadata.tools // [])[] else ((.metadata.tools.components // []) + (.metadata.tools.services // []))[] end) | select((.name // \"\") != \"\") ] | length > 0"
        },
        {
          "id": "cisa-sbom-tool-version",
          "label": "SBOM tool version",
          "label_ko": "SBOM 생성 도구 버전",
          "source": "auto",
          "cdxPath": "[ (if ((.metadata.tools // null) | type) == \"array\" then (.metadata.tools // [])[] else ((.metadata.tools.components // []) + (.metadata.tools.services // []))[] end) ] as $t | ($t | length > 0) and ([ $t[] | select((.version // \"\") == \"\") ] | length == 0)"
        },
        {
          "id": "cisa-sbom-version",
          "label": "SBOM version",
          "label_ko": "SBOM 문서 버전",
          "source": "auto",
          "cdxPath": "(.version // null) != null"
        }
      ]
    },
    {
      "id": "cisa-component",
      "name": "Component data",
      "name_ko": "구성요소 데이터",
      "elements": [
        {
          "id": "cisa-component-name",
          "label": "Component name",
          "label_ko": "구성요소 이름",
          "source": "auto",
          "missingPath": "[ $subjects[] | select((.name // \"\") == \"\") | (.purl // \"(unnamed)\") ]"
        },
        {
          "id": "cisa-component-version",
          "label": "Component version",
          "label_ko": "구성요소 버전",
          "source": "auto",
          "missingPath": "[ $subjects[] | select((.version // \"\") == \"\") | (.name // \"(unnamed)\") ]"
        },
        {
          "id": "cisa-component-producer",
          "label": "Component producer",
          "label_ko": "구성요소 생산자",
          "source": "auto",
          "missingPath": "[ $subjects[] | select((((.authors // []) | length) == 0) and ((.publisher // \"\") == \"\") and (((.supplier // {}) | length) == 0) and (((.manufacturer // {}) | length) == 0)) | (.name // \"(unnamed)\") ]"
        },
        {
          "id": "cisa-component-identifiers",
          "label": "Component identifiers",
          "label_ko": "구성요소 식별자",
          "source": "auto",
          "missingPath": "[ $subjects[] | select(((.purl // \"\") == \"\") and ((.cpe // \"\") == \"\") and (((.hashes // []) | length) == 0) and ((.swhid // \"\") == \"\")) | (.name // \"(unnamed)\") ]",
          "evidencePath": "[ $subjects[] | (.purl // .cpe) | select(. != null and . != \"\") ] | unique"
        },
        {
          "id": "cisa-component-license",
          "label": "Component license",
          "label_ko": "구성요소 라이선스",
          "source": "auto",
          "missingPath": "[ $subjects[] | select(((.licenses // []) | length) == 0) | (.name // \"(unnamed)\") ]"
        },
        {
          "id": "cisa-component-hash-value",
          "label": "Component hash value",
          "label_ko": "구성요소 해시 값",
          "source": "auto",
          "missingPath": "[ $subjects[] | select([ (.hashes // [])[] | select((.content // \"\") != \"\") ] | length == 0) | (.name // \"(unnamed)\") ]"
        },
        {
          "id": "cisa-component-hash-algorithm",
          "label": "Component hash algorithm",
          "label_ko": "구성요소 해시 알고리즘",
          "source": "auto",
          "missingPath": "[ $subjects[] | select(((.hashes // []) | length) > 0) | select([ (.hashes // [])[] | select((.alg // \"\") == \"\") ] | length > 0) | (.name // \"(unnamed)\") ]"
        },
        {
          "id": "cisa-component-dependency-relationship",
          "label": "Component dependency relationship",
          "label_ko": "구성요소 의존 관계",
          "source": "auto",
          "cdxPath": "[ .dependencies[]? | .dependsOn[]? ] | length > 0"
        }
      ]
    },
    {
      "id": "cisa-practices",
      "name": "Practices and processes",
      "name_ko": "운영 원칙",
      "elements": [
        {
          "id": "cisa-machine-processable-data",
          "label": "Machine-processable data",
          "label_ko": "기계 판독 가능 데이터",
          "source": "auto",
          "cdxPath": "((.bomFormat // \"\") != \"\") or ((.spdxVersion // \"\") != \"\")"
        },
        {
          "id": "cisa-coverage",
          "label": "Coverage",
          "label_ko": "포함 범위",
          "source": "na"
        },
        {
          "id": "cisa-accommodation-of-updates",
          "label": "Accommodation of updates to SBOM data",
          "label_ko": "SBOM 데이터 갱신 수용",
          "source": "na"
        },
        {
          "id": "cisa-distribution-and-delivery",
          "label": "Distribution and delivery",
          "label_ko": "배포와 전달",
          "source": "na"
        },
        {
          "id": "cisa-explicit-unknowns",
          "label": "Explicitly identifying unknown information",
          "label_ko": "미상 정보의 명시",
          "source": "na"
        },
        {
          "id": "cisa-frequency",
          "label": "Frequency",
          "label_ko": "갱신 주기",
          "source": "na"
        }
      ]
    }
  ]
}
