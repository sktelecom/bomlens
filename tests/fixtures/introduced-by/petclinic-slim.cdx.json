  "dependencies": [
    {"ref": "root", "dependsOn": ["web", "snake"]},
    {"ref": "web", "dependsOn": ["tomcat-starter"]},
    {"ref": "tomcat-starter", "dependsOn": ["tomcat-core"]},
    {"ref": "tomcat-core", "dependsOn": []},
    {"ref": "snake", "dependsOn": []},
    {"ref": "orphan", "dependsOn": []}
  ]
}
